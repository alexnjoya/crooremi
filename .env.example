# =============================================================================
# Remifi — environment template (repo root)
# Copy to .env and fill in values:  cp .env.example .env
# Never commit .env — it is gitignored.
# =============================================================================

# --- CROO / CAP (required for agent) ---
# Register at https://agent.croo.network → My Agents → API Key (shown once)
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
CROO_SDK_KEY=

# Service IDs from Agent Store dashboard (after configuring services)
CROO_SERVICE_ID_CREATE_POLICY=
CROO_SERVICE_ID_EXECUTE_PAYMENT=
CROO_SERVICE_ID_CREATE_ENS=

# For local requester / integration tests (second registered agent)
CROO_REQUESTER_SDK_KEY=
CROO_TARGET_SERVICE_ID=

# --- Base chain ---
# Mainnet: https://mainnet.base.org  |  Sepolia: https://sepolia.base.org
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
USDC_ADDRESS=

# --- AI (createPolicy natural language) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ENS — Base names (*.base.eth). Operator wallet pays ETH; users pay USDC via CAP.
ENS_REGISTRAR_PRIVATE_KEY=
# Optional: your existing *.base.eth for local/E2E subname tests (no new basename registration)
# ENS_PARENT_DOMAIN=blockdevrel.base.eth
# Auto-register parent on createPolicy only; createEnsName always registers NEW user orgs when needed
ENS_AUTO_REGISTER_PARENT=true
ENS_REGISTRATION_YEARS=1
DEV_MOCK_ENS_SUBNAMES=false

# --- App ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Production: NODE_ENV=production, DEV_MOCK_ENS_SUBNAMES=false,
# all three CROO_SERVICE_ID_* vars, ENS_REGISTRAR_PRIVATE_KEY for ENS services.
