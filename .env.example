# =============================================================================
# Remifi — environment template (repo root)
# Copy to .env and fill in values:  cp .env.example .env
# Never commit .env — it is gitignored.
# =============================================================================

# --- CROO / CAP (required for agent) ---
# Register at https://agent.croo.network → My Agents → API Key (shown once)
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
CROO_SDK_KEY=

# Optional: service IDs from Agent Store dashboard (after configuring services)
CROO_SERVICE_ID_CREATE_POLICY=
CROO_SERVICE_ID_EXECUTE_PAYMENT=

# For local requester / integration tests (second registered agent)
CROO_REQUESTER_SDK_KEY=
CROO_TARGET_SERVICE_ID=

# --- Base chain (required for USDC splits) ---
# Mainnet: https://mainnet.base.org  |  Sepolia: https://sepolia.base.org
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532

# USDC contract on Base
# Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Sepolia: verify current address at https://docs.base.org
USDC_ADDRESS=

# Agent wallet private key — only if signing splits outside CAP AA wallet
# Prefer CAP-provided AA wallet; leave empty until chain module is wired
AGENT_WALLET_PRIVATE_KEY=

# --- AI policy interpreter (one of) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Phase 2 contracts (optional — leave empty for MVP) ---
DEPLOYER_PRIVATE_KEY=
POLICY_REGISTRY_ADDRESS=
PAYMENT_ROUTER_ADDRESS=

# --- Web demo (Next.js — also copied to web/.env.local) ---
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_AGENT_STORE_URL=https://agent.croo.network

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
