# Remifi Web demo (Next.js)
# Copy to web/.env.local (Next.js convention):
#   cp .env.example .env.local

# Public vars only — safe to expose in browser (no secrets here)
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_USDC_ADDRESS=

# After contract deploy (Phase 2)
NEXT_PUBLIC_POLICY_REGISTRY_ADDRESS=
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=

NEXT_PUBLIC_AGENT_STORE_URL=https://agent.croo.network
NEXT_PUBLIC_BASESCAN_URL=https://sepolia.basescan.org

# Optional: agent health endpoint for demo UI
NEXT_PUBLIC_AGENT_HEALTH_URL=http://localhost:3001/health
